# Datasheet Copilot 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略。

# ==== LLM（必填） ====
# 不要把真实 Key 写入 README、脚本或提交记录。
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=deepseek-v4-1-flash-261017

# 固定采样温度；MVP 默认 0.0。
LLM_TEMPERATURE=0.0

# 单次响应输出上限（token）与行级分块大小。
LLM_MAX_TOKENS=6000
LLM_ROWS_PER_CHUNK=10
LLM_MAX_SPLIT_DEPTH=6

# ==== 运行方案 ====
# d = Logical + P1 + recovered（默认）
# c = Flat + P1 + legacy（保守回退）
DATASHEET_RUN_PROFILE=d

# ==== Docling 本地模型（可选） ====
# 默认留空，由 Docling 自行下载/解析。
# 仅在已准备离线模型目录时取消注释，并确认目录存在；
# 模型权重不随仓库发布，见 docs/DATA_LAYOUT.md。
# DOCLING_ARTIFACTS_PATH=./docling-models

# ==== 可选：受控实验覆盖 ====
# 通常不需要设置。用于复用已冻结的 Logical 输入。
# RECOVERED_EVIDENCE_LOGICAL_ROWS=data/outputs/TPS7A02.logical_rows.v1.json
# RECOVERED_EVIDENCE_RAW_STRUCTURE=data/outputs/TPS7A02.raw_structure.v1.json
# EXTRACTION_INPUT_MODE=logical
# EVIDENCE_VALIDATION_MODE=recovered
# PROMPT_FAMILY_COVERAGE=1
